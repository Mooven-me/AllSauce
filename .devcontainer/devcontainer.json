{
    "remoteEnv": {
        "PATH": "${containerEnv:PATH}:/home/nonroot/.kilo/bin",
        "XDG_DATA_HOME": "/home/nonroot/.local/share",
        "XDG_CONFIG_HOME": "/home/nonroot/.config",
        "XDG_CACHE_HOME": "/home/nonroot/.cache",
        "XDG_STATE_HOME": "/home/nonroot/.local/state"
    },
    "name": "Symfony Docker",
    "dockerComposeFile": [
        "../compose.yaml",
        "../compose.override.yaml",
        "compose.devcontainer.yaml"
    ],
    "service": "php",
    "workspaceFolder": "/app",
    "features": {
        "ghcr.io/devcontainers/features/node:1": {}
    },
    "remoteUser": "nonroot",
    "postCreateCommand": "npm install -g intelephense; curl -fsSL https://kilo.ai/cli/install | bash",
    "customizations": {
        "vscode": {
            "extensions": [
                "bmewburn.vscode-intelephense-client",
                "xdebug.php-debug",
                "kilocode.kilo-code"
            ],
            "settings": {
                "launch": {
                    "version": "0.2.0",
                    "configurations": [
                        {
                            "name": "Debug PHP",
                            "type": "php",
                            "request": "launch"
                        }
                    ]
                }
            }
        }
    }
}
