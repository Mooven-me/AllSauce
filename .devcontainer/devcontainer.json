{
    "remoteEnv": {
        "PATH": "${containerEnv:PATH}:/home/nonroot/.kilo/bin",
        "XDG_DATA_HOME": "/home/nonroot/.local/share",
        "XDG_CONFIG_HOME": "/home/nonroot/.config",
        "XDG_CACHE_HOME": "/home/nonroot/.cache",
        "XDG_STATE_HOME": "/home/nonroot/.local/state"
    },
    "name": "Symfony Docker",
    "dockerComposeFile": [
        "../compose.yaml",
        "../compose.override.yaml",
        "compose.devcontainer.yaml"
    ],
    "service": "php",
    "workspaceFolder": "/app",
    "remoteUser": "nonroot",
    "features": {
        "ghcr.io/devcontainers/features/node:1": {}
    },
    "overrideCommand": false,
    "customizations": {
        "jetbrains": {
            "plugins": [
                "fr.adrienbrault.idea.symfony2plugin",
                "com.jetbrains.twig",
                "com.jetbrains.php",
                "de.espend.idea.php.annotation",
            ],
            "settings": {
                "com.intellij:app:BuiltInServerOptions.builtInServerPort": 62697,
                "com.intellij:app:HttpConfigurable.use_proxy_pac": true
            }
        },
        "vscode": {
            "extensions": [
                "bmewburn.vscode-intelephense-client",
                "xdebug.php-debug",
                "kilocode.kilo-code",
                "thenouillet.symfony-vscode"
            ],
            "settings": {
                "launch": {
                    "version": "0.2.0",
                    "configurations": [
                        {
                            "name": "Debug PHP",
                            "type": "php",
                            "request": "launch"
                        }
                    ]
                }
            }
        }
    }
}
